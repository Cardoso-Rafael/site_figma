/* ====================================================================
1. VARIÁVEIS CSS (:root) & RESET BÁSICO
=====================================================================*/
:root {
  /* Paleta de Cores COBR!TO */
  --bg-main: #0B0C0E;             /* Fundo ultra escuro */
  --bg-card: #121418;             /* Fundo de cards/checkout */
  --bg-card-hover: #1A1D24;       /* Fundo de cards em hover */
  --bg-glass: rgba(11, 12, 14, 0.8); /* Fundo translúcido para Glassmorphism */
  
  --color-primary: #D4A338;       /* Dourado Metálico */
  --color-primary-hover: #F0B83E; /* Dourado Claro */
  --color-accent: #1DB9C3;        /* Azul Ciano Destaque */
  --bg-accent: #0E2938;           /* Fundo da Badge Ciano */
  
  --color-text: #FFFFFF;          /* Texto principal (Branco) */
  --color-text-muted: #8E9299;    /* Texto secundário (Cinza) */
  --color-border: #1E2229;        /* Bordas sutis */

  /* Fontes, Raios e Transições */
  --font-main: 'Plus Jakarta Sans', sans-serif;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-full: 999px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Reset universal */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 🌊 NAVEGAÇÃO SUAVE E CONFIGURAÇÕES DE PÁGINA */
html {
  scroll-behavior: smooth; /* Deslize suave ao clicar nos links */
  scroll-padding-top: 90px; /* Evita que o header fixo cubra o topo da seção */
  font-family: var(--font-main);
  background-color: var(--bg-main);
  color: var(--color-text);
}

body {
  line-height: 1.6;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 40px;
  overflow-x: hidden;
}

/* Utilitário de Acessibilidade */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

/* ====================================================================
2. CABEÇALHO FIXO COM GLASSMORPHISM (.header)
=================================================================== */
.header {
  position: sticky; /* Fixa no topo ao rolar */
  top: 0;
  z-index: 1000;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  
  /* 💎 EFEITO DE VIDRO (GLASSMORPHISM) */
  background: var(--bg-glass);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(212, 163, 56, 0.15); /* Borda sutil dourada */
}

.logo, .footer-logo {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: 1px;
  color: var(--color-text);
  text-decoration: none;
}

.logo span, .footer-logo span {
  color: var(--color-primary);
}

.nav {
  display: flex;
  gap: 32px;
}

.nav a {
  color: #9499C3;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: var(--transition);
}

.nav a:hover {
  color: var(--color-primary);
}

.btn-header {
  border: 1px solid var(--color-primary);
  color: var(--color-primary);
  padding: 10px 20px;
  border-radius: 6px;
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
  transition: var(--transition);
}

.btn-header:hover {
  background-color: var(--color-primary);
  color: var(--bg-main);
  box-shadow: 0 0 15px rgba(212, 163, 56, 0.4);
}

/* ====================================================================
3. SEÇÃO HERO (.hero) COM DEGRADÊ LENDÁRIO
=================================================================== */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
  padding: 60px 0 80px;
}

.badge {
  background-color: var(--bg-accent);
  color: var(--color-accent);
  font-size: 11px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 12px;
  letter-spacing: 0.5px;
  display: inline-block;
}

/* 🎨 TÍTULO COM DEGRADÊ MODERNO DOURADO/BRANCO */
.hero-content h1 {
  font-size: 42px;
  font-weight: 800;
  line-height: 1.2;
  margin: 16px 0 20px;
  
  background: linear-gradient(135deg, #FFFFFF 30%, #D4A338 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.description {
  color: var(--color-text-muted);
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 32px;
  max-width: 500px;
}

/* ====================================================================
4. CARD DE CHECKOUT RÁPIDO & BOTÕES
=================================================================== */
.card-checkout {
  background-color: var(--bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  max-width: 520px;
  transition: var(--transition);
}

.card-checkout:hover {
  border-color: rgba(212, 163, 56, 0.3);
}

.checkout-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20px;
}

.product-name {
  color: var(--color-text-muted);
  font-size: 14px;
}

.price {
  font-size: 28px;
  font-weight: 800;
}

.currency {
  color: var(--color-primary);
  font-size: 16px;
}

.btn-primary {
  width: 100%;
  background-color: var(--color-primary);
  color: var(--bg-main);
  border: none;
  padding: 16px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition);
}

.btn-primary:hover {
  background-color: var(--color-primary-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(212, 163, 56, 0.3);
}

/* ====================================================================
5. IMAGEM DO PRODUTO
=================================================================== */
.hero-image {
  display: flex;
  justify-content: center;
}

.image-wrapper {
  border: 1px solid var(--color-primary);
  border-radius: 20px;
  overflow: hidden;
  max-width: 500px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  transition: var(--transition);
}

.image-wrapper:hover {
  transform: scale(1.02);
}

.image-wrapper img {
  width: 100%;
  height: auto;
  display: block;
}

/* ====================================================================
6. SEÇÃO DE BENEFÍCIOS COM CSS GRID RESPONSIVO
=================================================================== */
.benefits-section {
  text-align: center;
  padding: 60px 0 100px;
}

.section-tag {
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin-bottom: 12px;
}

.benefits-section h2, .section-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 48px;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.card-benefit {
  background-color: var(--bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  text-align: left;
  transition: var(--transition);
}

/* Efeito de elevação e brilho dourado no hover */
.card-benefit:hover {
  transform: translateY(-8px);
  border-color: var(--color-primary);
  box-shadow: 0 12px 30px rgba(212, 163, 56, 0.15);
}

.card-benefit--featured {
  border-color: rgba(212, 163, 56, 0.4);
  background: linear-gradient(180deg, var(--bg-card) 0%, rgba(212, 163, 56, 0.05) 100%);
}

.icon-box {
  background-color: var(--bg-card-hover);
  width: 44px;
  height: 44px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-bottom: 20px;
}

.card-benefit h3 {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 12px;
}

.card-benefit p {
  color: var(--color-text-muted);
  font-size: 13px;
  line-height: 1.6;
}

/* ====================================================================
7. CAPTURA DE LEADS (NEWSLETTER)
=================================================================== */
.newsletter {
  padding: 60px 0 90px;
}

.newsletter-container {
  background-color: var(--bg-card);
  border: 1px solid var(--color-border);
  border-radius: 20px;
  padding: 48px;
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
}

.newsletter-form {
  display: flex;
  gap: 12px;
  margin-top: 24px;
  justify-content: center;
}

.newsletter-field {
  flex: 1;
}

.newsletter-input {
  width: 100%;
  padding: 16px 20px;
  border-radius: 10px;
  border: 1px solid var(--color-border);
  background-color: var(--bg-main);
  color: var(--color-text);
  font-size: 14px;
  outline: none;
  transition: var(--transition);
}

.newsletter-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(212, 163, 56, 0.2);
}

.btn-newsletter {
  width: auto;
  padding: 16px 28px;
  white-space: nowrap;
}

/* ====================================================================
8. RODAPÉ (.footer)
=================================================================== */
.footer {
  text-align: center;
  padding: 40px 0;
  border-top: 1px solid #16191E;
}

.footer p {
  color: #585C66;
  font-size: 12px;
  margin-top: 12px;
}

/* ====================================================================
9. RESPONSIVIDADE (MEDIA QUERIES)
==================================================================== */
@media (max-width: 868px) {
  body {
    padding: 0 20px;
  }

  .nav {
    display: none; /* Oculta a navegação no mobile */
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    padding-top: 20px;
  }

  .hero-content h1 {
    font-size: 32px;
  }

  .description {
    margin-left: auto;
    margin-right: auto;
  }

  .card-checkout {
    margin: 0 auto;
  }

  .newsletter-form {
    flex-direction: column;
  }

  .btn-newsletter {
    width: 100%;
  }
}

/* ADICIONE ESTE CÓDIGO AO SEU ARQUIVO STYLE.CSS */
.social-contact {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  padding: 40px 0 20px;
  width: 100%;
}

.btn-social {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border-radius: var(--radius-sm, 8px);
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: var(--transition, all 0.3s ease);
}

.btn-whatsapp {
  background-color: #25D366;
  color: #000000;
}

.btn-whatsapp:hover {
  background-color: #20ba5a;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
}

.btn-linkedin {
  background-color: #0A66C2;
  color: #FFFFFF;
}

.btn-linkedin:hover {
  background-color: #084e96;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(10, 102, 194, 0.3);
}

@media (max-width: 600px) {
  .social-contact {
    flex-direction: column;
  }
  
  .btn-social {
    width: 100%;
    justify-content: center;
  }
}


